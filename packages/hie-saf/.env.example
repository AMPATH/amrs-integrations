# Copy to .env and fill in values. Do not commit secrets.

# HIE OAuth
HIE_AUTH_URL=https://accounts-uat.dha.go.ke/realms/hie/protocol/openid-connect/token
HIE_CLIENT_ID=
HIE_CLIENT_SECRET=
HIE_GRANT_TYPE=client_credentials

# HIE facade (registries, HWR, etc.)
HIE_BASE_URL=https://ilm-dev.dha.go.ke/adapter/facade

# eClaims / preauth middleware (POST /api/v1/preauths, claims, OTP, authorize)
# Local override: keep this pointing at DHA UAT (or a mock), while the ESM
# app points hieBaseUrl at this hie-saf instance (e.g. http://localhost:3000).
HIE_CLIAMS_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware

AMRS_BASE_URL=

DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=hie
DATABASE_POOL_SIZE=20

APP_ENV=development
BASIC_AUTH=
