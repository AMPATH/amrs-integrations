# Copy to .env and fill in values. Do not commit secrets.

# HIE OAuth
HIE_AUTH_URL=
HIE_CLIENT_ID=
HIE_CLIENT_SECRET=
HIE_GRANT_TYPE=client_credentials
# Test-only: if set, skips the client-credentials fetch and uses this token
# as-is for every request. Leave unset outside local/manual testing.
HIE_TEST_BEARER_TOKEN=

# HIE facade (registries, HWR, etc.)
HIE_BASE_URL=

# eClaims / preauth middleware (POST /api/v1/preauths, claims, OTP, authorize)
# Local override: keep this pointing at DHA UAT (or a mock), while the ESM
# app points hieBaseUrl at this hie-saf instance (e.g. http://localhost:3000).
HIE_CLIAMS_BASE_URL=

AMRS_BASE_URL=
# Test-only: stands in for the browser's JSESSIONID cookie on
# POST /emt/handover/initiate when there's no real OpenMRS SPA session to
# pull it from. Leave unset outside local/manual testing.
HIE_TEST_SESSION_COOKIE=

DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=hie
DATABASE_POOL_SIZE=20

APP_ENV=development
BASIC_AUTH=

# Telemedicine (Livia) partner SSO — POST {LIVIA_SSO_BASE_URL}/api/partner/sso/token
# with username/password headers, minting a practitioner session for the
# patient-chart Telemedicine tab. All three unset = route answers 503 and the
# rest of the service is unaffected.
LIVIA_SSO_BASE_URL=
LIVIA_SSO_USERNAME=
LIVIA_SSO_PASSWORD=

# DHA ETL gateway — Basic-auth facade in front of the cookie-auth ETL.
# Callers send Authorization: Basic; the gateway validates against OpenMRS,
# mints a JSESSIONID, and forwards GET /etl-gateway/<route> to ETL_GATEWAY_TARGET
# with that session attached. Both keys are optional (sensible defaults).
ETL_GATEWAY_TARGET=http://127.0.0.1:8002
ETL_GATEWAY_TIMEOUT_MS=25000

# DHA FHIR facade — Kenya Core meta.profile stamping proxy over OpenMRS FHIR2.
# Patient is preloaded with the laboratory-confirmed profile. Add profiles for
# other resource types as DHA confirms the canonicals (JSON, resourceType -> URL):
#   DHA_PROFILE_MAP={"Condition":"http://hl7.dha.go.ke/ig/core/StructureDefinition/kenya-core-condition/0.1.0"}
DHA_PROFILE_MAP=
